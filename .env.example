# vigress environment. Copy to .env (gitignored); Bun loads it automatically.
# Every variable is optional except FIGMA_TOKEN when the baseline is `figma:KEY/NODE`.
# A CLI flag always wins over the matching variable below.
#
# AI agents: never print, cat or commit .env or any *.state.json (live credentials).
# Do not run `login` or `dashboard` yourself; both block. Ask the human.

# --- Figma baselines -------------------------------------------------------
# Personal access token (Figma > Settings > Security). Needs read access to the file.
# Required only for `--against figma:FILEKEY/NODEID`. Leave empty otherwise.
FIGMA_TOKEN=

# --- Capture defaults ------------------------------------------------------
# Viewport as WIDTHxHEIGHT in px. Flag: --viewport
VIGRESS_VIEWPORT=1440x900

# Saved login session (made by a human with `login`). Flag: --state
# Needed for pages behind sign-in. Check it with: login --url <url> --state <file> --check
# VIGRESS_STATE=auth.state.json

# Folder for diffs, video and reports. Flag: --out
# VIGRESS_OUT=out

# Browser to drive: chrome | msedge | chrome-beta | msedge-beta (system install, no download).
# VIGRESS_BROWSER=chrome

# --- Tuning ----------------------------------------------------------------
# Max ms to wait for network idle per capture. Raise for slow data, lower for faster runs.
# VIGRESS_SETTLE=8000

# Ms to hold after each interaction step (video pacing).
# VIGRESS_DWELL=1000

# --- Dashboard (human only) ------------------------------------------------
# Comma-separated Tailscale logins allowed to make changes through `tailscale serve`.
# Empty = nobody on the tailnet can change anything; reads stay open.
# VIGRESS_DASHBOARD_WRITERS=you@example.com
